
<h1>Thêm sản phẩm</h1>

<form method="post" action="/Expense/Create">
	<label>Title</label>
	<input type="text" name="Title" />		
	<label>Amount</label>
	<input type="number" name="Amount" />
	<label>Date</label>
	<input type="date" name="Date" />
	<label>Category</label>
	<input type="text" name="Category" />

	<button type="submit">Thêm</button>
</form>